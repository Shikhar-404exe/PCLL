# Azure OpenAI Configuration (Optional)
# Copy this file to .env and fill in your actual values
# The .env file is gitignored for security

# Azure OpenAI Endpoint
# Example: https://your-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI Deployment Name
# The name of your deployed model (e.g., gpt-4, gpt-35-turbo)
AZURE_OPENAI_DEPLOYMENT=

# Azure OpenAI API Key
# Your API key from Azure Portal
AZURE_OPENAI_API_KEY=

# Enable Azure Insights (true/false)
# Set to false to disable all Azure features
AZURE_INSIGHTS_ENABLED=false

# Azure Cosmos DB Configuration (Optional)
# Cosmos DB endpoint URL
# Example: https://your-account.documents.azure.com:443/
COSMOS_DB_ENDPOINT=

# Cosmos DB Primary Key
# Your primary key from Azure Portal
COSMOS_DB_PRIMARY_KEY=

# Cosmos DB Database Name
# The database name you created (e.g., pcll_db)
COSMOS_DB_DATABASE=pcll_db

# Cosmos DB Container Name
# The container name for ledger entries (e.g., ledger_entries)
COSMOS_DB_CONTAINER=ledger_entries

# Enable Cosmos DB Sync (true/false)
# Set to false to use local SQLite only
COSMOS_DB_SYNC_ENABLED=false

# Sync Interval in Minutes
# How often to sync with cloud (default: 5 minutes)
COSMOS_DB_SYNC_INTERVAL=5

# Database Configuration (Optional - for future use)
# LOCAL_DB_PATH=
# BACKUP_ENABLED=true

# App Configuration (Optional - for future use)
# APP_ENV=production
# DEBUG_MODE=false
# LOG_LEVEL=info
